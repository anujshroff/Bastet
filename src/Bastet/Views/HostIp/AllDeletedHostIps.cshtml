@model AllDeletedHostIpsViewModel
@inject Bastet.Services.IUserContextService UserContextService

@{
    ViewData["Title"] = "All Deleted Host IP Assignments";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <h1>All Deleted Host IP Assignments</h1>
        @if (Model.TotalCount > 0 && UserContextService.UserHasRole(Bastet.Models.ApplicationRoles.Admin))
        {
            <a asp-action="PurgeAllDeletedHostIps" class="btn btn-danger">
                <i class="bi bi-trash"></i> Purge All
            </a>
        }
    </div>
    <p class="lead">View all deleted host IP assignments across all subnets</p>
</div>

@await Html.PartialAsync("_TempDataAlerts")

@if (Model.TotalCount == 0)
{
    <div class="alert alert-info">
        <p class="mb-0">No deleted host IP assignments found in any subnet.</p>
    </div>
}
else
{
    <div class="alert alert-secondary mb-4">
        <p class="mb-0">
            <i class="bi bi-info-circle me-2"></i>
            Showing <strong>@(((Model.CurrentPage - 1) * Model.PageSize) + 1)-@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)</strong> 
            of <strong>@Model.TotalCount</strong> deleted host IP assignment(s).
        </p>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">Deleted Host IP Assignments</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>IP Address</th>
                            <th>Name</th>
                            <th>Original Subnet</th>
                            <th>Deleted</th>
                            <th>Deleted By</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hostIp in Model.DeletedHostIps)
                        {
                            <tr>
                                <td><code>@hostIp.OriginalIP</code></td>
                                <td>@(string.IsNullOrEmpty(hostIp.Name) ? "-" : hostIp.Name)</td>
                                <td>
                                    @*
                                        Deliberately no address range. This column is headed "Original
                                        Subnet", but the only prefix available at render time is the
                                        subnet's *current* one - the prefix as it stood when the
                                        address was archived is not stored anywhere. Those differ
                                        precisely when the subnet was narrowed after the address was
                                        deleted, which is the one edit deleting it makes possible:
                                        ValidateSubnetCidrChangeWithHostIps returns early when a
                                        subnet has no live host IPs. The pairing then read as a
                                        containment claim that was false and unconstructible -
                                        10.150.0.200 shown inside 10.150.0.0/25 - because the live
                                        listing renders the byte-identical string where containment
                                        *is* guaranteed. The name and the link are enough to navigate.
                                    *@
                                    @if (hostIp.SubnetName != "Unknown")
                                    {
                                        <text>@hostIp.SubnetName</text>
                                    }
                                    else
                                    {
                                        <text>Unknown (Original Subnet ID: @hostIp.OriginalSubnetId)</text>
                                    }
                                </td>
                                <td>@hostIp.DeletedAt.ToString("g")</td>
                                <td>@(string.IsNullOrEmpty(hostIp.DeletedBy) ? "-" : hostIp.DeletedBy)</td>
                                <td>@hostIp.CreatedAt.ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <nav aria-label="Pagination">
                <ul class="pagination justify-content-center mb-0">
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="AllDeletedHostIps" asp-route-page="1">First</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" asp-action="AllDeletedHostIps" asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">First</span>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Previous</span>
                        </li>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" asp-action="AllDeletedHostIps" asp-route-page="@(Model.CurrentPage + 1)">Next</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" asp-action="AllDeletedHostIps" asp-route-page="@Model.TotalPages">Last</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">Next</span>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Last</span>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
}

<div class="mt-4">
    <a asp-controller="Subnet" asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to Subnet Hierarchy
    </a>
</div>
