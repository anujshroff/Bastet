@inject Bastet.Services.IIpUtilityService IpUtility
@{
    string cidrInfoJson = System.Text.Json.JsonSerializer.Serialize(
        Enumerable.Range(0, 33).Select(c => new
        {
            mask = IpUtility.CalculateSubnetMask(c),
            total = IpUtility.CalculateTotalIpAddresses(c),
            usable = IpUtility.CalculateUsableIpAddresses(c)
        }));
}
<script>

    const cidrInfo = @Html.Raw(cidrInfoJson);

    function updateSubnetInfo() {
        const cidrValue = parseInt($('#Cidr').val(), 10);

        if (!isNaN(cidrValue) && cidrValue >= 0 && cidrValue <= 32) {
            const info = cidrInfo[cidrValue];

            $('#subnetMaskDisplay').text(info.mask);
            $('#maxIpsDisplay').text(info.total.toLocaleString());
            $('#usableIpsDisplay').text(info.usable.toLocaleString());
        } else {
            $('#subnetMaskDisplay').text('Invalid CIDR');
            $('#maxIpsDisplay').text('-');
            $('#usableIpsDisplay').text('-');
        }
    }

    function initializeForm() {
        const cidrInput = $('#Cidr');

        if (cidrInput.val() !== '') {
            updateSubnetInfo();
        } else {
            $('#subnetMaskDisplay').text('');
            $('#maxIpsDisplay').text('-');
            $('#usableIpsDisplay').text('-');
        }
    }

    $(document).ready(function() {
        $('#Cidr').on('input', updateSubnetInfo);

        initializeForm();
    });
</script>
