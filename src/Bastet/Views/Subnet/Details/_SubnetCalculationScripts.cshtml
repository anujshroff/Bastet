@model SubnetDetailsViewModel
@inject Bastet.Services.IIpUtilityService IpUtility
@{
    string usableByCidrJson = System.Text.Json.JsonSerializer.Serialize(
        Enumerable.Range(0, 33).Select(c => IpUtility.CalculateUsableIpAddresses(c)));

    string childSubnetSuggestionsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.ChildSubnetSuggestions.Select(s => new
        {
            startIp = s.StartIp,
            recommendedCidr = s.RecommendedCidr,
            networkAddressByCidr = s.NetworkAddressByCidr
        }));
}

<script>

    const parentId = @Model.Id;
    const parentCidr = @Model.Cidr;
    const usableByCidr = @Html.Raw(usableByCidrJson);
    const childSubnetSuggestions = @Html.Raw(childSubnetSuggestionsJson);

    $(document).ready(function() {

        $('[data-bs-toggle="tooltip"]').tooltip();

        const minCidr = parentCidr + 1;
        const maxCidr = 32;
        let activeSuggestion = null;

        function markNetworkAddressAdjusted() {
            $('#networkAddressDisplay').addClass('border-warning');
            $('#networkAddressHelp').html('<span class="text-warning">This network address has been adjusted to avoid overlaps.</span>');
            $('#networkAddressHelp').removeClass('d-none');
        }

        function makeNetworkAddressReadOnly() {
            $('#networkAddressDisplay').prop('readonly', true);
            $('#networkAddressDisplay').removeClass('border-warning');
            $('#networkAddressHelp').addClass('d-none');
        }

        function refuse(message, sizeText) {
            $('#cidrInput').removeClass('is-valid').addClass('is-invalid');
            $('#createSubnetBtn').prop('disabled', true);
            $('#cidrValidationFeedback').text(message);
            $('#subnetSizeDisplay').text(sizeText);
        }

        $('.create-subnet-btn').click(function() {
            const startIp = $(this).attr('data-network');
            activeSuggestion = childSubnetSuggestions.find(s => s.startIp === startIp);

            $('#networkAddressDisplay').val(activeSuggestion.startIp);
            $('#validCidrRange').text(`${minCidr} - ${maxCidr} (recommended: ${activeSuggestion.recommendedCidr})`);

            $('#cidrInput').attr('min', minCidr);
            $('#cidrInput').attr('max', maxCidr);
            $('#cidrInput').val(activeSuggestion.recommendedCidr);

            makeNetworkAddressReadOnly();

            $('#cidrInput').removeClass('is-invalid is-valid');
            $('#cidrValidationFeedback').text('Please enter a valid CIDR value within the allowed range.');
            $('#subnetSizeDisplay').text(usableByCidr[activeSuggestion.recommendedCidr].toLocaleString());

            const modal = new bootstrap.Modal(document.getElementById('cidrInputModal'));
            modal.show();

            $('#createSubnetBtn').prop('disabled', false);
        });

        $('#cidrInput').on('input', function() {
            const cidrValue = parseInt($(this).val());
            const address = activeSuggestion.networkAddressByCidr[cidrValue];

            if (address === undefined) {
                $('#networkAddressDisplay').val(activeSuggestion.startIp);
                makeNetworkAddressReadOnly();
                refuse('Please enter a valid CIDR value within the allowed range.', 'Invalid');
                return;
            }

            if (address === null) {
                refuse('No compatible network address found for this CIDR size.', 'Invalid - No compatible address');
                return;
            }

            $('#networkAddressDisplay').val(address);

            if (address === activeSuggestion.startIp) {
                makeNetworkAddressReadOnly();
            } else {
                markNetworkAddressAdjusted();
            }

            $(this).removeClass('is-invalid').addClass('is-valid');
            $('#createSubnetBtn').prop('disabled', false);
            $('#cidrValidationFeedback').text('Please enter a valid CIDR value within the allowed range.');
            $('#subnetSizeDisplay').text(usableByCidr[cidrValue].toLocaleString());
        });

        $('#createSubnetBtn').click(function() {
            const query = new URLSearchParams({
                networkAddress: $('#networkAddressDisplay').val(),
                cidr: $('#cidrInput').val(),
                parentId: parentId
            });

            window.location.href = '@Url.Action("Create", "Subnet")' + '?' + query.toString();
        });
    });
</script>
